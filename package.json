{
  "name": "kovrune",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source, local-first research app: answers about your own documents, with quotes checked against their sources, from a model on your own machine.",
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "checksums": "node --experimental-strip-types scripts/checksums.ts",
    "release:sign": "node --experimental-strip-types scripts/release.ts sign",
    "release:verify": "node --experimental-strip-types scripts/release.ts verify",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "bench:endpoint": "node --experimental-strip-types eval/cli.ts",
    "bench:retrieval": "node --experimental-strip-types eval/retrieval.ts",
    "bench:browser": "vite --config eval/browser/vite.config.ts",
    "bench:browser:build": "vite build --config eval/browser/vite.config.ts",
    "build:redirect": "vite build --config redirect/vite.config.ts",
    "pin:browser-models": "node --experimental-strip-types scripts/pin-browser-models.ts",
    "bench:compare": "node --experimental-strip-types eval/compare.ts",
    "bench:rescore": "node --experimental-strip-types eval/rescore.ts",
    "bench:rereview": "node --experimental-strip-types eval/rereview.ts",
    "bench:crosscheck": "node --experimental-strip-types eval/crosscheck.ts",
    "bench:completeness": "node --experimental-strip-types eval/completeness.ts"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.85",
    "@wllama/wllama": "3.8.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}

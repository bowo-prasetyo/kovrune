{
  "name": "kovrune",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source, browser-first, peer-to-peer agentic AI ecosystem for research and software development.",
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "bench:endpoint": "node --experimental-strip-types eval/cli.ts",
    "bench:browser": "vite --config eval/browser/vite.config.ts",
    "bench:browser:build": "vite build --config eval/browser/vite.config.ts"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.85",
    "@wllama/wllama": "3.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
